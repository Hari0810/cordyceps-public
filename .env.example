# Copy this file to .env and restart the helper server.
# Leave optional credentials blank unless you are wiring those integrations yourself.

# Optional PostgreSQL connection string for legacy server-state/account paths.
# Local PWA mode can run without this.
DATABASE_URL=

# Web Push VAPID contact subject
VAPID_SUBJECT=mailto:admin@example.com

# Optional helper routes. RSS/article fetching is always on.
# CORDYCEPS_ENABLE_OUTLOOK_HELPER=1
# CORDYCEPS_ENABLE_BANKING_HELPER=1

# Notes encryption key — 64 hex chars (32 bytes). If unset, an ephemeral key is generated on startup.
# Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
NOTES_ENCRYPTION_KEY=

# Banking / Budget read-only sync.
# Generate BANKING_TOKEN_ENCRYPTION_KEY with:
# python3 -c "import secrets; print(secrets.token_hex(32))"
ENABLE_BANKING_APP_ID=
# Use either a PEM file path or the PEM contents with escaped \n line breaks.
ENABLE_BANKING_PRIVATE_KEY_PATH=
# ENABLE_BANKING_PRIVATE_KEY=
ENABLE_BANKING_ENV=sandbox
ENABLE_BANKING_REDIRECT_URI=http://localhost:4179/api/banking/enable/callback
BANKING_TOKEN_ENCRYPTION_KEY=
# Optional: consent and sync windows for Enable Banking.
# ENABLE_BANKING_ACCESS_DAYS=90
# ENABLE_BANKING_TRANSACTION_SYNC_DAYS=90

# Legacy banking providers. Hidden in the UI and not recommended for new setup.
# TRUELAYER_CLIENT_ID=
# TRUELAYER_CLIENT_SECRET=
# TRUELAYER_REDIRECT_URI=http://localhost:4179/api/banking/truelayer/callback

# Google Sign-In OAuth
AUTH_GOOGLE_CLIENT_ID=
AUTH_GOOGLE_CLIENT_SECRET=
# Defaults to <origin>/api/auth/oauth/google/callback — override if needed
# AUTH_GOOGLE_REDIRECT_URI=

# Microsoft Sign-In OAuth
AUTH_MICROSOFT_CLIENT_ID=
AUTH_MICROSOFT_CLIENT_SECRET=
AUTH_MICROSOFT_TENANT=consumers
# AUTH_MICROSOFT_REDIRECT_URI=

# SMTP for magic link emails and email summaries
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=noreply@example.com

# Vite dev server: extra allowed hostnames (comma-separated).
# Used only when running from the original source/development layout.
# Example: VITE_ALLOWED_HOSTS=my-tunnel.example.com,myapp.example.net
VITE_ALLOWED_HOSTS=
